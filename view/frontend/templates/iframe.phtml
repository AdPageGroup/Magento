<?php
declare(strict_types=1);

use Tagging\GTM\Config\Config;
use Tagging\GTM\ViewModel\AgentFilter;
use Tagging\GTM\ViewModel\HelperScript;
use Magento\Framework\View\Element\Template;

/** @var Config $config */
/** @var Template $block */
$config = $block->getConfig();
/** @var HelperScript|null $helperScript */
$helperScript = $block->getHelperScript();
$isHyva = isset($hyvaCsp) && $hyvaCsp;

// Sets window.trytagging_skip for a visitor the agent filter matches. Empty when nothing is filtered, and then this template
// renders what it always did
$agentFilter = $block->getData('agent_filter');
$skipScript = $agentFilter instanceof AgentFilter ? $agentFilter->getSkipScript() : '';

// What a skipped visitor gets instead of the helper script: the dataLayer events go out right away, without it
$helperScriptSkipped = "window.Tagging_HELPER_SCRIPT = 'skipped';\nwindow.Tagging_HELPER_SCRIPT_FAILED = true;";

// Get SecureHtmlRenderer using Object Manager for compatibility
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$secureRenderer = $objectManager->get(\Magento\Framework\View\Helper\SecureHtmlRenderer::class);

if ($config->isEnabled() && $config->getGoogleTagmanagerUrl() && strlen($config->getGoogleTagmanagerUrl()) > 0 && $config->isPlacedByPlugin()) :
    
    // First script - proxy domain
    $proxyScript = "window.tagging_proxy_domain = 'https://" . $config->getGoogleTagmanagerUrl() . "';";
    if ($skipScript !== '') {
        // Usually script.phtml has decided already, this copy only counts when it is not on the page
        $proxyScript = $skipScript . "\n" . $proxyScript;
    }
    
    if ($isHyva): ?>
        <script><?= $proxyScript ?></script><?php $hyvaCsp->registerInlineScript() ?>
    <?php else:
        echo $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $proxyScript, false);
    endif; ?>
    
    <?php
    // Helper script (window.taggingHelpers), placed inline when the plugin has a copy of it: it is then there
    // before the dataLayer events are sent, and ad blockers do not see the tagging domain
    $inlineHelperScript = $helperScript ? $helperScript->getInlineScript() : null;
    if ($inlineHelperScript !== null):
        $inlineHelperScript .= "\nwindow.Tagging_HELPER_SCRIPT = 'inline';";
        if ($skipScript !== '') {
            $inlineHelperScript = "if (!window.trytagging_skip) {\n" . $inlineHelperScript . "\n} else {\n"
                . $helperScriptSkipped . "\n}";
        }

        if ($isHyva): ?>
            <script><?= /* @noEscape */ $inlineHelperScript ?></script><?php $hyvaCsp->registerInlineScript() ?>
        <?php else:
            echo $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $inlineHelperScript, false);
        endif;
    else:
        $helperScriptUrl = $helperScript
            ? $helperScript->getUrl()
            : 'https://' . $config->getGoogleTagmanagerUrl() . '/user-data-minified.es.js';

        if ($skipScript === ''):
        ?>
        <!-- External script - no CSP needed as it's whitelisted in csp_whitelist.xml -->
        <script id="tagging-helper-script" defer src="<?= $block->escapeUrl($helperScriptUrl) ?>"></script>
        <?php
        endif;

        // Lets the dataLayer events go out right away when the script cannot be loaded, instead of waiting for it
        $helperScriptListener = "window.Tagging_HELPER_SCRIPT = 'external';
document.getElementById('tagging-helper-script').addEventListener('error', function() {
    window.Tagging_HELPER_SCRIPT_FAILED = true;
    document.dispatchEvent(new CustomEvent('trytagging_user_data_failed'));
});";

        if ($skipScript !== '') {
            // With an agent filter the script is added from here, and only for a visitor it does not match
            $helperScriptListener = "if (window.trytagging_skip) {\n" . $helperScriptSkipped . "\n} else {\n"
                . "var taggingHelperScript = document.createElement('script');\n"
                . "taggingHelperScript.id = 'tagging-helper-script';\n"
                . "taggingHelperScript.src = " . json_encode($helperScriptUrl, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) . ";\n"
                . "taggingHelperScript.async = false;\n"
                . "document.head.appendChild(taggingHelperScript);\n"
                . $helperScriptListener . "\n}";
        }

        if ($isHyva): ?>
            <script><?= /* @noEscape */ $helperScriptListener ?></script><?php $hyvaCsp->registerInlineScript() ?>
        <?php else:
            echo $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $helperScriptListener, false);
        endif;
    endif;
    // Main functionality script
    $mainScript = '
/**
 * Generate simple hash based only on items and quantities
 * @param {Object} eventData - GA4 event data
 * @returns {string} Base64 encoded hash
 */
window.tagging_gtm_simple_hash = function(eventData) {
    if (!eventData.ecommerce || !eventData.ecommerce.items) {
        return "";
    }

    const parts = [];

    eventData.ecommerce.items.forEach(item => {
        const itemId = item.item_id || "";
        const quantity = item.quantity || 0;
        parts.push(`i_id=${itemId}&qt=${quantity}`);
    });

    const value = parts.join("&");
    return btoa(value);
};

/**
 * Generate advanced hash based on items, quantities, and user agent
 * @param {Object} eventData - GA4 event data
 * @returns {string} Base64 encoded hash
 */
window.tagging_gtm_advanced_hash = function(eventData) {
    if (!eventData.ecommerce || !eventData.ecommerce.items) {
        return "";
    }

    const parts = [];

    eventData.ecommerce.items.forEach(item => {
        const itemId = item.item_id || "";
        const quantity = item.quantity || 0;
        parts.push(`i_id=${itemId}&qt=${quantity}`);
    });

    const userAgent = navigator.userAgent || "";
    const normalizedUserAgent = userAgent.toLowerCase().replace(/\s+/g, "");
    parts.push(`--ua=${normalizedUserAgent}`);

    const value = parts.join("&");
    return btoa(value);
};

window.tagging_gtm_save_hash = function(hash, marketingObject) {' . ($skipScript !== '' ? '
    // A visitor the agent filter matches sends nothing to the tagging domain
    if (window.trytagging_skip) {
        return;
    }' : '') . '
    if (!hash || !marketingObject) {
        console.error("Hash or marketingObject is missing");
        return;
    }

    fetch(window.tagging_proxy_domain + "/_tools/kv/" + hash, {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
        },
        body: JSON.stringify({
            value: marketingObject,
        }),
    })
    .then(() => {
        return;
    })
    .catch((err) => {
        console.error(`Error sending data to API`, err);
    });
};';
    
    if ($isHyva): ?>
        <script><?= $mainScript ?></script><?php $hyvaCsp->registerInlineScript() ?>
    <?php else:
        echo $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $mainScript, false);
    endif;
endif; ?>