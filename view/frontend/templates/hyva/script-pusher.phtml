<script>
    // Assigned on window rather than declared, so a second render of this
    // template cannot break the page on a duplicate declaration
    window.Tagging_GTM_PURCHASE_EVENT = 'trytagging_purchase';
    window.Tagging_GTM_PUSHED_TRANSACTIONS_KEY = 'tagging_gtm_pushed_transactions';
    window.Tagging_GTM_PUSHED_TRANSACTIONS_MAX = 50;
    window.Tagging_GTM_PUSHED_EVENT_KEYS_KEY = 'tagging_gtm_pushed_event_keys';
    window.Tagging_GTM_PUSHED_EVENT_KEYS_MAX = 50;
    window.Tagging_GTM_SESSION_EVENT_MAX_AGE = 2 * 60 * 60;

    /**
     * Serialize with the object keys sorted, so that two events holding the same
     * values hash to the same string even when the keys were assembled in a
     * different order server-side.
     */
    function googleTagManager2StableStringify(value) {
        if (Array.isArray(value)) {
            return '[' + value.map(googleTagManager2StableStringify).join(',') + ']';
        }

        if (value && typeof value === 'object') {
            return '{' + Object.keys(value).sort().map(function (key) {
                return JSON.stringify(key) + ':' + googleTagManager2StableStringify(value[key]);
            }).join(',') + '}';
        }

        const serialized = JSON.stringify(value);

        return typeof serialized === 'undefined' ? 'null' : serialized;
    }

    function googleTagManager2GetPushedTransactions() {
        try {
            const stored = JSON.parse(window.localStorage.getItem(window.Tagging_GTM_PUSHED_TRANSACTIONS_KEY) || '[]');

            return Array.isArray(stored) ? stored : [];
        } catch (error) {
            // No storage available, fall back to the in-memory guard only
            return [];
        }
    }

    function googleTagManager2RememberTransaction(transactionId) {
        try {
            const transactions = googleTagManager2GetPushedTransactions();
            transactions.push(transactionId);

            window.localStorage.setItem(
                window.Tagging_GTM_PUSHED_TRANSACTIONS_KEY,
                JSON.stringify(transactions.slice(-window.Tagging_GTM_PUSHED_TRANSACTIONS_MAX))
            );
        } catch (error) {
            // No storage available, fall back to the in-memory guard only
        }
    }

    function googleTagManager2GetPushedEventKeys() {
        try {
            const stored = JSON.parse(window.localStorage.getItem(window.Tagging_GTM_PUSHED_EVENT_KEYS_KEY) || '[]');

            return Array.isArray(stored) ? stored : [];
        } catch (error) {
            // No storage available, fall back to the max age guard only
            return [];
        }
    }

    function googleTagManager2RememberEventKey(eventKey) {
        try {
            const eventKeys = googleTagManager2GetPushedEventKeys();
            eventKeys.push(eventKey);

            window.localStorage.setItem(
                window.Tagging_GTM_PUSHED_EVENT_KEYS_KEY,
                JSON.stringify(eventKeys.slice(-window.Tagging_GTM_PUSHED_EVENT_KEYS_MAX))
            );
        } catch (error) {
            // No storage available, fall back to the max age guard only
        }
    }

    /**
     * The key of a non-cacheable event that was queued in the session, or null.
     * Such an event can be delivered again by a later section load, or replayed
     * from the section data that Hyvä caches in localStorage.
     */
    function googleTagManager2GetEventKey(metaData) {
        if (!metaData || metaData.cacheable === true || !metaData.event_key) {
            return null;
        }

        return String(metaData.event_key);
    }

    /**
     * Fallback for when the pushed keys are not available: an event that was
     * queued in the session this long ago is a replay, not a new occurrence.
     */
    function googleTagManager2IsExpired(metaData) {
        const createdAt = Number(metaData.created_at);
        if (!createdAt) {
            return false;
        }

        return Date.now() / 1000 - createdAt > window.Tagging_GTM_SESSION_EVENT_MAX_AGE;
    }

    /**
     * The transaction a purchase event belongs to, or null for any other event.
     * The in-memory guard is reset on every page load, so purchases are also
     * deduplicated on their transaction to survive a reload of the success page.
     */
    function googleTagManager2GetTransactionId(eventData) {
        if (eventData.event !== window.Tagging_GTM_PURCHASE_EVENT || !eventData.ecommerce) {
            return null;
        }

        const transactionId = eventData.ecommerce.transaction_id;

        return transactionId ? String(transactionId) : null;
    }

    function googleTagManager2Pusher(eventData, message) {
        window.Tagging_GTM_PAST_EVENTS = window.Tagging_GTM_PAST_EVENTS || [];

        // Never push the caller's object itself: GTM stamps gtm.uniqueEventId on every pushed
        // object, and customer section events are the very objects Hyvä writes to localStorage
        // after private-content-loaded, so a cached event would be replayed on every page load
        const copyEventData = Object.assign({}, eventData);
        let metaData = {};
        if (copyEventData.meta) {
            metaData = copyEventData.meta;
            delete copyEventData.meta;
        }

        // Drop what a previous push added, so section data cached by an older version of this
        // script still hashes the same as the event rendered in the page
        Object.keys(copyEventData).forEach(function (key) {
            if (key.indexOf('gtm.') === 0 || key === 'marketing' || key === 'device') {
                delete copyEventData[key];
            }
        });

        // Prevent the same purchase from being triggered twice, across page loads
        const transactionId = googleTagManager2GetTransactionId(copyEventData);
        if (transactionId && googleTagManager2GetPushedTransactions().includes(transactionId)) {
            googleTagManager2Logger('Warning: Purchase already triggered for transaction "' + transactionId + '"', eventData);
            return;
        }

        // Prevent a session event from being replayed, across page loads
        const eventKey = googleTagManager2GetEventKey(metaData);
        if (eventKey && googleTagManager2GetPushedEventKeys().includes(eventKey)) {
            googleTagManager2Logger('Warning: Event "' + eventKey + '" already triggered', eventData);
            return;
        }

        if (eventKey && googleTagManager2IsExpired(metaData)) {
            googleTagManager2Logger('Warning: Skipping expired event "' + eventKey + '"', eventData);
            return;
        }

        const eventHash = btoa(encodeURIComponent(googleTagManager2StableStringify(copyEventData)));
        if (window.Tagging_GTM_PAST_EVENTS.includes(eventHash)) {
            googleTagManager2Logger('Warning: Event already triggered', eventData);
            return;
        }

        if (metaData && metaData.allowed_pages && metaData.allowed_pages.length > 0 &&
            false === metaData.allowed_pages.some(page => window.location.pathname.includes(page))) {
            googleTagManager2Logger('Warning: Skipping event, not in allowed pages', window.location.pathname, eventData);
            return;
        }

        if (!message) {
            message = 'push (unknown) [unknown]';
        }

        if (window.taggingHelpers) {
            copyEventData.marketing = window.taggingHelpers.getMarketingObject();
            copyEventData.device = window.taggingHelpers.getDeviceInfo();
        }

        if (copyEventData.marketing) {
            const expires = new Date();
            expires.setTime(expires.getTime() + 7 * 24 * 60 * 60 * 1000);
            document.cookie = `trytagging_user_data=${btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(copyEventData.marketing))))};expires=${expires.toUTCString()};path=/`;
        }

        googleTagManager2Logger(message, eventData);
        window.dataLayer = window.dataLayer || [];
        if (copyEventData.ecommerce) {
            window.dataLayer.push({
                ecommerce: null
            });
        }

        try {
            if ((copyEventData.event === 'trytagging_begin_checkout' || copyEventData.event === 'trytagging_view_cart') && copyEventData.marketing) {
                const simpleHash = window.tagging_gtm_simple_hash(copyEventData);
                const advancedHash = window.tagging_gtm_advanced_hash(copyEventData);

                window.tagging_gtm_save_hash(simpleHash, copyEventData.marketing);
                window.tagging_gtm_save_hash(advancedHash, copyEventData.marketing);
            }
        } catch (error) {
            console.error('Error generating hashes:', error);
        }

        window.dataLayer.push(copyEventData);
        window.Tagging_GTM_PAST_EVENTS.push(eventHash);

        if (transactionId) {
            googleTagManager2RememberTransaction(transactionId);
        }

        if (eventKey) {
            googleTagManager2RememberEventKey(eventKey);
        }
    }
</script><?php if (isset($hyvaCsp) && $hyvaCsp): ?><?php $hyvaCsp->registerInlineScript() ?><?php endif; ?>
