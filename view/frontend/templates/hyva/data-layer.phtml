<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Tagging\GTM\Config\Config;
use Tagging\GTM\ViewModel\DataLayer;

/** @var DataLayer $dataLayerViewModel */
/** @var Config $config */
/** @var Template $block */
$config = $block->getConfig();
$dataLayerViewModel = $block->getDataLayerViewModel();
$dataLayerJson = $dataLayerViewModel->getDataLayerAsJson();
$dataLayerEventsJsonChunks = $dataLayerViewModel->getDataLayerEventsAsJsonChunks();
?>
<script>
    function callInitialDataLayer() {
        <?php foreach ($dataLayerEventsJsonChunks as $dataLayerEventsJsonChunk) : ?>
            googleTagManager2Pusher(<?= /* @noEscape */ $dataLayerEventsJsonChunk ?>, 'push (page-based event) [data-layer.phtml]');
        <?php endforeach; ?>
    }

    document.addEventListener("DOMContentLoaded", function() {
        // The helper script adds the marketing and device data to the events. Placed inline it is always there,
        // loaded from the tagging domain it can arrive late or be blocked. The events are sent either way
        var timeout;
        var isSent = false;
        var sendInitialDataLayer = function() {
            if (isSent) {
                return;
            }

            isSent = true;
            clearTimeout(timeout);
            if (!window.taggingHelpers) {
                console.log("taggingHelpers not available, sending initial data layer without marketing data");
            }

            setTimeout(function() {
                callInitialDataLayer();
            }, 100); // Make sure we always sent after user_data
        };

        if (window.taggingHelpers || window.Tagging_HELPER_SCRIPT_FAILED) {
            sendInitialDataLayer();
            return;
        }

        document.addEventListener("trytagging_user_data_ready", sendInitialDataLayer);
        document.addEventListener("trytagging_user_data_failed", sendInitialDataLayer);
        timeout = setTimeout(sendInitialDataLayer, 3000);
    });

    googleTagManager2Pusher(<?= /* @noEscape */ $dataLayerJson ?>, 'push (initial page) [data-layer.phtml]');
</script><?php if (isset($hyvaCsp) && $hyvaCsp): ?><?php $hyvaCsp->registerInlineScript() ?><?php endif; ?>