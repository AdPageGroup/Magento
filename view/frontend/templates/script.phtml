<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Tagging\GTM\Config\Config;

/** @var Config $config */
/** @var Template $block */
$config = $block->getConfig();

// Get SecureHtmlRenderer using Object Manager for compatibility
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$secureRenderer = $objectManager->get(\Magento\Framework\View\Helper\SecureHtmlRenderer::class);

// Detect if we're in Hyvä context
$isHyva = isset($hyvaCsp) && $hyvaCsp;

// Build the script content
$scriptContent = <<<SCRIPT
window.Tagging_GTM_ENABLED = true;
SCRIPT;

if ($config->isEnabled()) {
    $scriptContent .= "\nwindow.Tagging_ENABLED_PLUGIN = true;";
} else {
    $scriptContent .= "\nwindow.Tagging_ENABLED_PLUGIN = false;";
}

if ($config->isPlacedByPlugin()) {
    $scriptContent .= "\nwindow.Tagging_PLACED_BY_PLUGIN = true;";
} else {
    $scriptContent .= "\nwindow.Tagging_PLACED_BY_PLUGIN = false;";
}

$scriptContent .= "\nwindow.Tagging_PLUGIN_VERSION = '{$config->getVersion()}';";

$scriptContent .= <<<SCRIPT

(function(events) {
    const initgoogleTagManager2 = function() {
        events.forEach(function(eventType) {
            window.removeEventListener(eventType, initgoogleTagManager2);
        });
SCRIPT;

$isContainerPlaced = $config->isEnabled() && $config->isPlacedByPlugin();

if ($isContainerPlaced && $config->isDuplicateContainerPrevented()) {
    $scriptContent .= <<<SCRIPT

        const loadContainer = function() {
SCRIPT;

    $scriptContent .= "\n" . $config->getConfig();

    $scriptContent .= <<<SCRIPT

        };

        // Google tag gateway, or another route, may have loaded this container already. It is
        // recognised by its ID, which the container code holds with or without the GTM- prefix
        const containerCode = loadContainer.toString();
        const loadedContainer = Object.keys(window.google_tag_manager || {}).find(function(key) {
            return key.indexOf('GTM-') === 0 && containerCode.indexOf(key.substring(4)) !== -1;
        });

        // Safari 16.4+ gets its cookies restored through the request for the container (Cookie
        // Keeper), so there the container code keeps running. Same check as the container code
        const safari = /Version\/([0-9\._]+)(.*Mobile)?.*Safari.*/.exec(navigator.userAgent);
        const needsCookieKeeper = containerCode.indexOf('enableCK') !== -1
            && safari !== null && parseFloat(safari[1]) >= 16.4;

        window.Tagging_CONTAINER_SKIPPED = Boolean(loadedContainer) && !needsCookieKeeper;
        if (!window.Tagging_CONTAINER_SKIPPED) {
            loadContainer();
            return;
        }

        // The container code also announces the page view. Google tag gateway does not, so
        // without this the tags on a page view trigger would never fire
        window.dataLayer = window.dataLayer || [];
        const isPageViewAnnounced = window.dataLayer.some(function(entry) {
            return entry && entry.event === 'gtm.js';
        });
        if (!isPageViewAnnounced) {
            window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
        }
SCRIPT;
} elseif ($isContainerPlaced) {
    $scriptContent .= "\n" . $config->getConfig();
}

$scriptContent .= <<<SCRIPT

    }

    events.forEach(function(eventType) {
        window.addEventListener(eventType, initgoogleTagManager2, {
            once: true,
            passive: true
        })
    })
})(['load']);
SCRIPT;

// Render the main script based on context
if ($isHyva): ?>
    <script>
        <?= $scriptContent ?>
    </script><?php $hyvaCsp->registerInlineScript() ?>
<?php else:
    echo $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $scriptContent, false);
endif; ?>

<?php if ($config->isDebug()) : ?>
    <?php
    $debugScript = "window.Tagging_GTM_DEBUG = true;";
    if ($isHyva): ?>
        <script>
            <?= $debugScript ?>
        </script><?php $hyvaCsp->registerInlineScript() ?>
    <?php else:
        echo $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $debugScript, false);
    endif; ?>
<?php endif; ?>